{
  "name": "desktop-app",
  "homepage": "./",
  "version": "02.11.15",
  "private": true,
  "author": "Zahra Jafarifard",
  "description": "Electron desktop administration app for Dolat Exchange.",
  "main": "public/main.js",
  "build": {
    "appId": "com.electron.myapp",
    "productName": "Exhub",
    "artifactName": "Exhub.${ext}" ,
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb"
    },
    "nsis": {
      "createDesktopShortcut": "always"
    }
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.22.9",
    "@reduxjs/toolkit": "^1.9.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "javascript-binary-converter": "^1.0.2",
    "mysql": "^2.18.1",
    "mysql2": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.6.2",
    "react-scripts": "5.0.1",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "sass": "^1.57.1",
    "sass-loader": "^13.2.0",
    "sequelize": "^6.28.0",
    "socket.io": "^4.6.1",
    "style-loader": "^3.3.1",
    "web-vitals": "^2.1.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron:package:mac": "npm run build && electron-builder -m -c.extraMetadata.main=build/main.js",
    "electron:package:win": "npm run build && electron-builder -w -c.extraMetadata.main=build/main.js",
    "electron:package:linux": "npm run build && electron-builder -l -c.extraMetadata.main=build/main.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-react": "^7.18.6",
    "babel-loader": "^9.1.2",
    "electron": "^25.5.0",
    "electron-builder": "^24.6.3",
    "tailwindcss": "^3.2.4"
  }
}
